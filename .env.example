# MinerU configuration
MINERU_MODE=local                    # "local" or "cloud"
MINERU_API_KEY=                      # required for cloud mode (get free token at https://mineru.net/apiManage/token)
MINERU_API_URL=http://localhost:8001 # local mineru-api endpoint
MINERU_TIMEOUT=300                   # seconds

# Storage
DATA_DIR=./data
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/outputs
TEMPLATE_DIR=./data/templates

# LLM (optional — enhances slide quality with better titles and bullet points)
LLM_API_KEY=                          # OpenAI-compatible API key (e.g., SiliconFlow: https://siliconflow.cn)
LLM_BASE_URL=https://api.openai.com/v1  # API base URL (SiliconFlow: https://api.siliconflow.cn/v1)
LLM_MODEL=deepseek-ai/DeepSeek-V3.2  # Model name
# Supported SiliconFlow models — change LLM_MODEL above if quality is unsatisfactory:
#   Qwen/Qwen3-30B-A3B-Instruct-2507
#   Qwen/Qwen3-30B-A3B-Thinking-2507
#   Qwen/Qwen3-235B-A22B-Instruct-2507
#   Qwen/Qwen3-Coder-30B-A3B-Instruct
#   deepseek-ai/DeepSeek-V3
#   deepseek-ai/DeepSeek-V3.1-Terminus
#   deepseek-ai/DeepSeek-V3.2
#   zai-org/GLM-4.5-Air   zai-org/GLM-4.5V
#   zai-org/GLM-4.6       zai-org/GLM-4.6V

# LaTeX
TEX_ENGINE=pdflatex                  # pdflatex, xelatex, or lualatex
LATEX_TIMEOUT=300                    # seconds (xelatex+CJK fonts need ~2-3 min on first run)
LATEX_RUNS=2                         # number of compilation passes
LLM_FIX_ATTEMPTS=5                   # max LLM repair rounds when latexmk reports errors

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/paper2beamer.db

# Web
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=50
SECRET_KEY=change-me-in-production
