# MinerU configuration
MINERU_MODE=local                    # "local" or "cloud"
MINERU_API_KEY=                      # required for cloud mode (get free token at https://mineru.net/apiManage/token)
MINERU_API_URL=http://localhost:8001 # local mineru-api endpoint
MINERU_TIMEOUT=300                   # seconds

# Storage
DATA_DIR=./data
CACHE_DIR=./data/cache
OUTPUT_DIR=./data/outputs
TEMPLATE_DIR=./data/templates

# LaTeX
TEX_ENGINE=pdflatex                  # pdflatex, xelatex, or lualatex
LATEX_TIMEOUT=120                    # seconds
LATEX_RUNS=2                         # number of compilation passes

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/paper2beamer.db

# Web
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=50
SECRET_KEY=change-me-in-production
